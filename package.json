{
  "name": "stremio-channels",
  "version": "0.1.1",
  "description": "Clock-synced linear TV channels for Stremio, programmed from debrid sources",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/Lancej1011/stremio-channels#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lancej1011/stremio-channels.git"
  },
  "bugs": {
    "url": "https://github.com/Lancej1011/stremio-channels/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "bin": {
    "stremio-channels": "dist/server.js",
    "stremio-channels-debrid-agent": "dist/debrid-agent.js"
  },
  "files": [
    "dist",
    "presets",
    "examples",
    "channels.example.json",
    "config.example.json",
    "README.md",
    "DOCKER.md",
    "RELEASING.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && npm run copy-assets",
    "copy-assets": "node -e \"const fs=require('fs'); fs.cpSync('src/ui','dist/ui',{recursive:true}); fs.cpSync('src/viewer','dist/viewer',{recursive:true})\"",
    "dev": "tsx watch src/server.ts",
    "desktop": "python3 desktop/headend.py",
    "desktop:install": "python3 desktop/headend.py --install",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:integration": "tsx --test \"src/**/*.itest.ts\"",
    "licenses:check": "node scripts/license-inventory.mjs --check",
    "licenses:report": "node scripts/license-inventory.mjs",
    "sbom": "cyclonedx-npm --omit dev --output-reproducible --validate",
    "workflows:check": "node scripts/check-workflow-pins.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "hls.js": "^1.6.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
