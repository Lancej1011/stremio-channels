# Copy to .env. Never commit the populated file.
# Recommended: Headend talks to a separately running credential broker and never receives
# the TorBox API key. The token authorizes only this local broker; it is not a provider key.
DEBRID_AGENT_URL=
DEBRID_AGENT_TOKEN=

# Legacy compatibility only. Prefer putting this key in the debrid agent instead.
TORBOX_API_KEY=
STREAM_ADDON_URL=

# Optional rich metadata discovery.
TMDB_API_TOKEN=
TMDB_API_KEY=

# The default Compose port is loopback-only. For another device, use Tailscale HTTPS
# and set this to the HTTPS URL created by `tailscale serve`.
PUBLIC_BASE_URL=http://127.0.0.1:7654

# Required to reach the server from anywhere but this machine, and carried as the first
# path segment of the addon URL. Leaving it empty means no authentication at all, which
# is only safe on loopback, a trusted LAN, or a private tailnet. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
ACCESS_TOKEN=

# Only for an intentionally trusted LAN/container boundary. Public release builds fail
# closed on a non-loopback bind without either ACCESS_TOKEN or this acknowledgement.
ALLOW_UNAUTHENTICATED_NON_LOOPBACK=false

# Hosts besides loopback allowed to reach the channel editor, comma separated, exactly as
# they appear in the address bar. Only needed once ACCESS_TOKEN is set.
TRUSTED_HOSTS=

# Keep signed provider URLs inside the server for remote viewers. Changing this to true
# is only for the operator's own devices when their provider explicitly permits it.
REMOTE_DIRECT_PLAY=false

# Signed download URLs are held only in memory. Keep this false for public releases.
PERSIST_RESOLVED_URLS=false

# Remote guide URLs cannot reach localhost, private networks, link-local services, or
# cloud metadata by default. Enable only if you intentionally host guides on your LAN.
ALLOW_PRIVATE_GUIDE_IMPORTS=false

# Imported poster URLs are removed by default so a guide author cannot track viewers.
ALLOW_IMPORTED_GUIDE_ARTWORK=false

# Automatic sources in someone else's guide can spend your catalogue API quotas or read
# your Stremio library. Prefer explicit-title guides and leave this disabled.
ALLOW_IMPORTED_GUIDE_SOURCES=false

# Remote authentication and playback-allocation abuse controls.
AUTH_FAILURE_LIMIT=20
AUTH_FAILURE_WINDOW_SECONDS=300
AUTH_BLOCK_SECONDS=900
TUNE_REQUEST_LIMIT_PER_MINUTE=30

# Persisted operation ceilings for direct TorBox and the isolated agent. Cache checks
# count once per 50 hashes; link, add, and file-list requests count once each.
DEBRID_HOURLY_OPERATION_LIMIT=120
DEBRID_DAILY_OPERATION_LIMIT=1000

# auto | nvenc | qsv | vaapi | cpu
ENCODER=auto
