# Copy to .env. Never commit the populated file.
# Configure exactly one resolver. Direct TorBox takes precedence when both are set.
TORBOX_API_KEY=
STREAM_ADDON_URL=

# Optional rich metadata discovery.
TMDB_API_TOKEN=
TMDB_API_KEY=

# The default Compose port is loopback-only. For another device, use Tailscale HTTPS
# and set this to the HTTPS URL created by `tailscale serve`.
PUBLIC_BASE_URL=http://127.0.0.1:7654

# auto | nvenc | qsv | vaapi | cpu
ENCODER=auto
